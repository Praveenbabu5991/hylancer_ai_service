# .env.example - Example environment variables for hylancer-ai-service

# Environment: 'dev' for development, 'prod' for production
ENV=dev

# Application port
APP_PORT=8000

# Database Configuration
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=hylancer_ai
POSTGRES_PORT=5433

# LLM Provider: 'openai', 'gemini', 'bedrock', or 'mock'
LLM_PROVIDER=openai

# OpenAI API Key (if LLM_PROVIDER is 'openai')
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"

# Google Gemini API Key (if LLM_PROVIDER is 'gemini')
# GOOGLE_API_KEY="YOUR_GEMINI_API_KEY"

# AWS Bedrock Configuration (if LLM_PROVIDER is 'bedrock')
# AWS_ACCESS_KEY_ID="YOUR_AWS_ACCESS_KEY_ID"
# AWS_SECRET_ACCESS_KEY="YOUR_AWS_SECRET_ACCESS_KEY"
# AWS_REGION="us-east-1" # e.g., us-east-1, eu-west-1

# Embedding Model
EMBEDDING_MODEL=text-embedding-3-large

# Internal Microservice URLs (example values)
BILLING_SERVICE_URL=http://billing-management:8081
CHAT_SERVICE_URL=http://chat-management:8082
PAYMENT_SERVICE_URL=http://payment-management:8083
PROJECT_SERVICE_URL=http://project-management:8084
USER_SERVICE_URL=http://user-management:8085