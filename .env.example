# .env.example - Example environment variables for hylancer-ai-service

# Environment: 'dev' for development, 'prod' for production
ENV=dev

# Application port
APP_PORT=8000

# Database Configuration
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=hylancer_ai
POSTGRES_PORT=5433

# DATABASE_URL - Choose one of the following connection modes:
#
# MODE 1: Use PostgreSQL from Docker container (default)
DATABASE_URL=postgresql+asyncpg://user:password@postgres:5432/hylancer_ai
#
# MODE 2: Use LOCAL PostgreSQL on host machine
# Option A: Use superuser for automatic database creation
# DATABASE_URL=postgresql+asyncpg://postgres:your_postgres_password@host.docker.internal:5432/hylancer_ai
#
# Option B: Use regular user (requires CREATEDB permission)
# DATABASE_URL=postgresql+asyncpg://user:password@host.docker.internal:5432/hylancer_ai
#
# NOTE: Database and tables are created automatically on startup!
# For local PostgreSQL mode:
# 1. Install pgvector: ./scripts/install_pgvector.sh (one-time)
# 2. Configure PostgreSQL for Docker: ./scripts/configure_postgres_docker.sh (one-time)
# 3. Add Docker network: ./scripts/fix_docker_network.sh (one-time)
# 4. Update DATABASE_URL with your local PostgreSQL credentials
# 5. Just run: docker-compose up (database auto-created!)

# LLM Provider: 'openai', 'gemini', 'bedrock', or 'mock'
LLM_PROVIDER=openai

# OpenAI API Key (if LLM_PROVIDER is 'openai')
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"

# Google Gemini API Key (if LLM_PROVIDER is 'gemini')
# GOOGLE_API_KEY="YOUR_GEMINI_API_KEY"

# AWS Bedrock Configuration (if LLM_PROVIDER is 'bedrock')
# AWS_ACCESS_KEY_ID="YOUR_AWS_ACCESS_KEY_ID"
# AWS_SECRET_ACCESS_KEY="YOUR_AWS_SECRET_ACCESS_KEY"
# AWS_REGION="us-east-1" # e.g., us-east-1, eu-west-1

# Embedding Model
EMBEDDING_MODEL=text-embedding-3-large

# Internal Microservice URLs (example values)
BILLING_SERVICE_URL=http://billing-management:8081
CHAT_SERVICE_URL=http://chat-management:8082
PAYMENT_SERVICE_URL=http://payment-management:8083
PROJECT_SERVICE_URL=http://project-management:8084
USER_SERVICE_URL=http://user-management:8085